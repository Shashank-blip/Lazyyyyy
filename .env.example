DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Local Gemma on this machine. Needs about 6 GB free.
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b
EMBED_MODEL=embeddinggemma

# Hosted Gemma, used by the Vercel deployment. See deploy/vercel.env.example.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=
# GEMMA_MODEL=gemma4
# OLLAMA_EMBED_HOST=http://127.0.0.1:11434
# OLLAMA_TIMEOUT=120
