# Paste these into the Vercel project → Settings → Environment Variables.
# Do not commit real values. Vercel cannot load Gemma weights.

# Tiger connection string. sslmode=require is required.
DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Hosted Gemma. Create the key at https://ollama.com/settings/keys
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
GEMMA_MODEL=gemma4

# EmbeddingGemma is not on ollama.com. This must be an Ollama server
# that has run `ollama pull embeddinggemma`. docker compose publishes
# the app and sets this to http://ollama:11434 for you.
# A Vercel deployment needs that server reachable from the internet,
# or the pile stops before search.
OLLAMA_EMBED_HOST=
EMBED_MODEL=embeddinggemma

# Per Gemma call. Two calls plus search need to finish inside Vercel's
# 300 second hobby limit.
OLLAMA_TIMEOUT=120
